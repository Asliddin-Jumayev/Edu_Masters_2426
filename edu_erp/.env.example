ADMIN_PASSWORD=change-me-too

# ---------- Umumiy ----------
PUBLIC_API_URL=https://api.example.uz      # webhook manzillari shu asosda ko'rsatiladi
FRONTEND_URL=http://localhost:5173         # email havolalari va sertifikat QR kodi uchun
CENTER_NAME=Edu Masters
TRUST_PROXY=false                          # nginx orqasida true (mijoz IP si X-Forwarded-For dan)

# ---------- Click (https://docs.click.uz) ----------
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ---------- Payme (https://developer.help.paycom.uz) ----------
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz   # sinov: https://test.paycom.uz

# ---------- SMS (Eskiz.uz) ----------
SMS_PROVIDER=console                       # eskiz — haqiqiy yuborish
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
SMS_CALLBACK_TOKEN=                        # yetkazish holati callback i uchun uzun tasodifiy qator

# ---------- Email (yangi qurilma xabarnomasi) ----------
EMAIL_BACKEND=auto                         # SMTP_HOST berilsa smtp, aks holda log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.uz
SMTP_STARTTLS=true
SMTP_SSL=false                             # 465-port uchun true (SMTP_STARTTLS=false)

LOG_LEVEL=INFO                             # console email/SMS va webhook loglari ko'rinishi uchun
